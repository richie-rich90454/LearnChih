{
  "openapi": "3.0.3",
  "info": {
    "title": "LernChih API",
    "description": "Static fallback OpenAPI spec for frontend codegen. Derived from the Spring Boot controllers for auth, resources, and channels.",
    "version": "0.0.0"
  },
  "servers": [
    {
      "url": "/api",
      "description": "Vite dev proxy / production API prefix"
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "operationId": "login",
        "tags": ["auth"],
        "summary": "Authenticate a user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "operationId": "register",
        "tags": ["auth"],
        "summary": "Register a new user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Registered"
          }
        }
      }
    },
    "/auth/verify": {
      "post": {
        "operationId": "verifyEmail",
        "tags": ["auth"],
        "summary": "Verify email with code",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmailRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verified"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "refresh",
        "tags": ["auth"],
        "summary": "Refresh access token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token refreshed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "tags": ["auth"],
        "summary": "Log out",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Logged out"
          }
        }
      }
    },
    "/auth/2fa/setup": {
      "post": {
        "operationId": "setupTotp",
        "tags": ["auth"],
        "summary": "Set up TOTP 2FA",
        "responses": {
          "200": {
            "description": "TOTP setup data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TotpSetupResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/2fa/verify": {
      "post": {
        "operationId": "verifyTotp",
        "tags": ["auth"],
        "summary": "Verify TOTP code",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TotpVerifyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verified"
          }
        }
      }
    },
    "/auth/password-reset-request": {
      "post": {
        "operationId": "requestPasswordReset",
        "tags": ["auth"],
        "summary": "Request password reset",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password reset requested"
          }
        }
      }
    },
    "/auth/password-reset": {
      "post": {
        "operationId": "resetPassword",
        "tags": ["auth"],
        "summary": "Reset password with token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetConfirmRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password reset"
          }
        }
      }
    },
    "/resources": {
      "get": {
        "operationId": "getResources",
        "tags": ["resources"],
        "summary": "List resources",
        "parameters": [
          {
            "name": "subjectId",
            "in": "query",
            "schema": { "type": "integer", "format": "int64" }
          },
          {
            "name": "category",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "format": "int32", "default": 0 }
          },
          {
            "name": "size",
            "in": "query",
            "schema": { "type": "integer", "format": "int32", "default": 20 }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated resources",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResourcePage"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createResource",
        "tags": ["resources"],
        "summary": "Create a resource (multipart or JSON)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateResourceRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/CreateResourceRequestMultipart"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResourceResponse"
                }
              }
            }
          }
        }
      }
    },
    "/resources/{id}": {
      "get": {
        "operationId": "getResource",
        "tags": ["resources"],
        "summary": "Get resource details",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Resource details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResourceDetailResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteResource",
        "tags": ["resources"],
        "summary": "Delete a resource",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          }
        }
      }
    },
    "/resources/{id}/upvote": {
      "post": {
        "operationId": "toggleUpvote",
        "tags": ["resources"],
        "summary": "Toggle upvote",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "Upvote toggled"
          }
        }
      }
    },
    "/resources/leaderboard": {
      "get": {
        "operationId": "getLeaderboard",
        "tags": ["resources"],
        "summary": "Get leaderboard",
        "responses": {
          "200": {
            "description": "Leaderboard entries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LeaderboardEntry"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/channels": {
      "get": {
        "operationId": "getChannels",
        "tags": ["channels"],
        "summary": "List channels",
        "responses": {
          "200": {
            "description": "Channels",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ChannelResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/channels/{id}": {
      "get": {
        "operationId": "getChannel",
        "tags": ["channels"],
        "summary": "Get channel",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Channel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChannelResponse"
                }
              }
            }
          }
        }
      }
    },
    "/channels/{id}/threads": {
      "get": {
        "operationId": "getChannelThreads",
        "tags": ["channels"],
        "summary": "List threads in a channel",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "format": "int32", "default": 0 }
          },
          {
            "name": "size",
            "in": "query",
            "schema": { "type": "integer", "format": "int32", "default": 20 }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated channel threads",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChannelThreadPage"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createChannelThread",
        "tags": ["channels"],
        "summary": "Create a thread in a channel",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateChannelThreadRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created thread",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChannelThreadResponse"
                }
              }
            }
          }
        }
      }
    },
    "/channels/threads/{threadId}/posts": {
      "get": {
        "operationId": "getChannelPosts",
        "tags": ["channels"],
        "summary": "List posts in a channel thread",
        "parameters": [
          {
            "name": "threadId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          },
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "format": "int32", "default": 0 }
          },
          {
            "name": "size",
            "in": "query",
            "schema": { "type": "integer", "format": "int32", "default": 50 }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated posts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostPage"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createChannelPost",
        "tags": ["channels"],
        "summary": "Create a post in a channel thread",
        "parameters": [
          {
            "name": "threadId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePostRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created post",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string" },
          "password": { "type": "string" }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": ["email", "password", "name"],
        "properties": {
          "email": { "type": "string" },
          "password": { "type": "string" },
          "name": { "type": "string" }
        }
      },
      "VerifyEmailRequest": {
        "type": "object",
        "required": ["email", "code"],
        "properties": {
          "email": { "type": "string" },
          "code": { "type": "string" }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "properties": {
          "refreshToken": { "type": "string" }
        }
      },
      "PasswordResetRequest": {
        "type": "object",
        "required": ["email"],
        "properties": {
          "email": { "type": "string" }
        }
      },
      "PasswordResetConfirmRequest": {
        "type": "object",
        "required": ["token", "newPassword"],
        "properties": {
          "token": { "type": "string" },
          "newPassword": { "type": "string" }
        }
      },
      "TotpSetupResponse": {
        "type": "object",
        "properties": {
          "secret": { "type": "string" },
          "qrCodeUrl": { "type": "string" }
        }
      },
      "TotpVerifyRequest": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": { "type": "string" }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "token": { "type": "string" },
          "userId": { "type": "integer", "format": "int64" },
          "email": { "type": "string" },
          "name": { "type": "string" },
          "role": { "type": "string" },
          "refreshToken": { "type": "string" }
        }
      },
      "AuthUser": {
        "type": "object",
        "properties": {
          "userId": { "type": "integer", "format": "int64" },
          "email": { "type": "string" },
          "name": { "type": "string" },
          "role": { "type": "string" }
        }
      },
      "ResourceCategory": {
        "type": "string",
        "enum": ["ARTICLE", "VIDEO", "PDF", "GUIDE", "LECTURE_RECORDING", "OTHER"]
      },
      "ResourceType": {
        "type": "string",
        "enum": ["UPLOAD", "LINK"]
      },
      "ResourceTag": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "name": { "type": "string" },
          "color": { "type": "string" }
        }
      },
      "ResourceResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "slug": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "category": { "type": "string" },
          "type": { "type": "string" },
          "filePath": { "type": "string", "nullable": true },
          "externalUrl": { "type": "string", "nullable": true },
          "userId": { "type": "integer", "format": "int64" },
          "userName": { "type": "string" },
          "subjectId": { "type": "integer", "format": "int64", "nullable": true },
          "subjectName": { "type": "string", "nullable": true },
          "upvoteCount": { "type": "integer", "format": "int32" },
          "upvotedByMe": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" },
          "authorName": { "type": "string" },
          "subject": { "type": "string" },
          "url": { "type": "string" },
          "tags": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ResourceTag" }
          }
        }
      },
      "CreateResourceRequest": {
        "type": "object",
        "required": ["title", "description", "category", "type"],
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" },
          "category": { "$ref": "#/components/schemas/ResourceCategory" },
          "type": { "$ref": "#/components/schemas/ResourceType" },
          "subjectId": { "type": "integer", "format": "int64" },
          "topicId": { "type": "integer", "format": "int64" },
          "courseId": { "type": "integer", "format": "int64" },
          "externalUrl": { "type": "string" }
        }
      },
      "CreateResourceRequestMultipart": {
        "type": "object",
        "required": ["title", "description", "category", "type"],
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" },
          "category": { "type": "string" },
          "type": { "type": "string" },
          "subjectId": { "type": "string" },
          "topicId": { "type": "string" },
          "courseId": { "type": "string" },
          "externalUrl": { "type": "string" },
          "file": { "type": "string", "format": "binary" }
        }
      },
      "PostResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "threadId": { "type": "integer", "format": "int64" },
          "userId": { "type": "integer", "format": "int64" },
          "userName": { "type": "string" },
          "content": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "authorName": { "type": "string" },
          "format": { "type": "string" }
        }
      },
      "ResourceDetailResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/ResourceResponse" },
          {
            "type": "object",
            "properties": {
              "threadId": { "type": "integer", "format": "int64" },
              "posts": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/PostResponse" }
              },
              "upvoted": { "type": "boolean" }
            }
          }
        ]
      },
      "ResourcePage": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ResourceResponse" }
          },
          "totalElements": { "type": "integer", "format": "int64" },
          "totalPages": { "type": "integer", "format": "int32" },
          "number": { "type": "integer", "format": "int32" },
          "size": { "type": "integer", "format": "int32" },
          "numberOfElements": { "type": "integer", "format": "int32" },
          "first": { "type": "boolean" },
          "last": { "type": "boolean" },
          "empty": { "type": "boolean" }
        }
      },
      "LeaderboardEntry": {
        "type": "object",
        "properties": {
          "userId": { "type": "integer", "format": "int64" },
          "name": { "type": "string" },
          "email": { "type": "string" },
          "credits": { "type": "integer", "format": "int32" }
        }
      },
      "ChannelResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "slug": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "threadCount": { "type": "integer", "format": "int32" },
          "createdAt": { "type": "string", "format": "date-time" },
          "threads": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ChannelThreadResponse" }
          }
        }
      },
      "ChannelThreadResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "channelId": { "type": "integer", "format": "int64" },
          "title": { "type": "string" },
          "userId": { "type": "integer", "format": "int64" },
          "userName": { "type": "string" },
          "postCount": { "type": "integer", "format": "int32" },
          "createdAt": { "type": "string", "format": "date-time" },
          "slug": { "type": "string" },
          "pinned": { "type": "boolean" },
          "locked": { "type": "boolean" },
          "qaMode": { "type": "boolean" },
          "authorName": { "type": "string" }
        }
      },
      "CreateChannelThreadRequest": {
        "type": "object",
        "required": ["title", "content"],
        "properties": {
          "title": { "type": "string" },
          "content": { "type": "string" },
          "format": { "type": "string" }
        }
      },
      "CreatePostRequest": {
        "type": "object",
        "required": ["content"],
        "properties": {
          "content": { "type": "string" },
          "format": { "type": "string" },
          "parentPostId": { "type": "integer", "format": "int64" }
        }
      },
      "ChannelThreadPage": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ChannelThreadResponse" }
          },
          "totalElements": { "type": "integer", "format": "int64" },
          "totalPages": { "type": "integer", "format": "int32" },
          "number": { "type": "integer", "format": "int32" },
          "size": { "type": "integer", "format": "int32" },
          "numberOfElements": { "type": "integer", "format": "int32" },
          "first": { "type": "boolean" },
          "last": { "type": "boolean" },
          "empty": { "type": "boolean" }
        }
      },
      "PostPage": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/PostResponse" }
          },
          "totalElements": { "type": "integer", "format": "int64" },
          "totalPages": { "type": "integer", "format": "int32" },
          "number": { "type": "integer", "format": "int32" },
          "size": { "type": "integer", "format": "int32" },
          "numberOfElements": { "type": "integer", "format": "int32" },
          "first": { "type": "boolean" },
          "last": { "type": "boolean" },
          "empty": { "type": "boolean" }
        }
      }
    }
  }
}
