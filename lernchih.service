[Unit]
Description=LernChih Spring Boot Application
After=network.target mysql.service

[Service]
Type=simple
User=lernchih
WorkingDirectory=/opt/lernchih
EnvironmentFile=/etc/lernchih/lernchih.env
ExecStart=/usr/bin/java -Xmx512m -jar /opt/lernchih/lernchih.jar
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
