# LernChih environment configuration template.
# Copy this file to `.env` (or to `.env.local` / `.env.docker`) and fill in the values.
# Variables marked as REQUIRED must be set before the application starts.
# Variables marked as OPTIONAL have sensible defaults in application.properties.

# -----------------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------------

# JWT signing secret. Must be at least 32 characters long and kept private.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters

# MySQL / database password. No default is provided.
DB_PASSWORD=change-me

# -----------------------------------------------------------------------------
# OPTIONAL - Datasource
# -----------------------------------------------------------------------------

# JDBC URL for the application database.
DB_URL=jdbc:mysql://localhost:3306/lernchih_db?useSSL=false&serverTimezone=UTC&useUnicode=true&characterEncoding=UTF-8

# Database username.
DB_USERNAME=root

# -----------------------------------------------------------------------------
# OPTIONAL - Server / CORS / SEO
# -----------------------------------------------------------------------------

# Port the Spring Boot backend listens on.
SERVER_PORT=38517

# Comma-separated list of allowed CORS origins.
# For single-port mode use http://localhost:${SERVER_PORT}.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Public base URL used to build absolute URLs in robots.txt and sitemaps.
SEO_BASE_URL=http://localhost:5173

# When true, enforce HTTPS channel + HSTS preload (use only behind a HTTPS terminator).
HTTPS_ONLY=false

# When true, normalize public URLs (trailing slash, lowercase, canonical host) via 301.
SEO_URL_NORMALIZE=false

# Optional canonical host (e.g. example.com). Leave empty to skip.
SEO_CANONICAL_HOST=

# -----------------------------------------------------------------------------
# OPTIONAL - Mail / SMTP (defaults point to a local Mailpit instance)
# -----------------------------------------------------------------------------

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_AUTH=false
MAIL_STARTTLS=false
# MAIL_USERNAME=
# MAIL_PASSWORD=

# -----------------------------------------------------------------------------
# OPTIONAL - OpenSearch
# -----------------------------------------------------------------------------

# OpenSearch host and port. Enable seed only when OpenSearch is available.
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_SEED_ENABLED=false
# OPENSEARCH_PASSWORD=StrongP@ssw0rd!

# -----------------------------------------------------------------------------
# OPTIONAL - Docker Compose exposed ports
# -----------------------------------------------------------------------------

# Ports exposed by docker-compose.yml for local data-store services.
# These only affect the host-side bindings; container ports remain unchanged.
MYSQL_PORT=3306
OPENSEARCH_HTTP_PORT=9200
OPENSEARCH_PERFORMANCE_PORT=9600
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
