# Docker-backed development environment.
# Copy this file to `.env.docker` before running:
#   docker compose -f infrastructure/docker-compose.yml up
# This file overrides values from `.env.example` for the Docker Compose network.
# See `.env.example` for full documentation of each variable.

# REQUIRED: must be set even in Docker dev.
JWT_SECRET=docker-dev-jwt-secret-must-be-at-least-32-characters-long

# MySQL service in docker-compose.yml is named `lernchih-mysql`.
# The compose file defaults DB_PASSWORD to `root`; this value must match.
DB_URL=jdbc:mysql://lernchih-mysql:3306/lernchih_db?useSSL=false&serverTimezone=UTC&useUnicode=true&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=root

# -----------------------------------------------------------------------------
# Docker service host/port overrides
# -----------------------------------------------------------------------------

# OpenSearch service in docker-compose.yml is named `lernchih-opensearch`.
OPENSEARCH_HOST=lernchih-opensearch
OPENSEARCH_PORT=9200
# OPENSEARCH_SEED_ENABLED=true
# OPENSEARCH_PASSWORD=StrongP@ssw0rd!

# Mailpit SMTP service in docker-compose.yml is named `lernchih-mailpit`.
MAIL_HOST=lernchih-mailpit
MAIL_PORT=1025

# Port the Spring Boot backend listens on.
SERVER_PORT=38517
