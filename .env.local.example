# H2 in-memory, single-port quick-start environment.
# Copy this file to `.env.local` and run the backend with the `local` Spring profile.
# This file intentionally contains only the values that differ from `.env.example`.
# See `.env.example` for full documentation of each variable.

# /!\ WARNING /!\
# This JWT secret is for LOCAL DEVELOPMENT ONLY. It is intentionally weak/public.
# NEVER use this value in production, staging, or any shared environment.
JWT_SECRET=local-dev-jwt-secret-must-be-at-least-32-characters-long

# Use an embedded H2 in-memory database instead of MySQL.
DB_URL=jdbc:h2:mem:lernchih;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE

# Serve the application and the bundled frontend SPA on a single port.
SERVER_PORT=8080
