<?xml version="1.0" encoding="UTF-8"?>
<!--
    Logback configuration for LernChih.

    - Production/default profiles emit structured JSON logs using the
      LogstashEncoder. The encoder automatically includes the MDC, so the
      "requestId" value populated by RequestIdFilter is included as the
      "requestId" field, and the X-Request-ID response header carries the same
      value for client-side tracing.
    - Local/dev/test profiles keep a human-readable pattern for console output
      during development and test runs.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProfile name="local,dev,test">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{requestId}] %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
    </springProfile>

    <springProfile name="!local,!dev,!test">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdcKeyName>requestId</includeMdcKeyName>
            </encoder>
        </appender>
    </springProfile>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
