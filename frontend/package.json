{
  "name": "lernchih",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "generate-api:live": "openapi-typescript http://localhost:8080/v3/api-docs -o src/generated/types.gen.ts",
    "generate-api:file": "openapi-typescript ../backend/lernchih/target/openapi.json -o src/generated/types.gen.ts",
    "generate-api:local": "openapi-typescript src/api/generated/openapi.json -o src/generated/types.gen.ts",
    "generate-api": "npm run generate-api:local",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lighthouse": "node ./tests-accessibility/lighthouse.test.mjs",
    "axe": "node ./tests-accessibility/axe.test.mjs",
    "pa11y": "node ./tests-accessibility/pa11y.test.mjs",
    "a11y": "npm run build && npm run lighthouse && npm run axe && npm run pa11y"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.3",
    "@fluentui/react-icons": "^2.0.331",
    "@gsap/react": "^2.1.2",
    "@stomp/stompjs": "^7.3.0",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.18.1",
    "gsap": "^3.15.0",
    "i18next": "^26.3.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.18.1",
    "sockjs-client": "^1.6.1",
    "vite-plugin-pwa": "^1.3.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/plugin-transform-runtime": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@hey-api/client-axios": "^0.9.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sockjs-client": "^1.5.4",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "axe-core": "^4.10.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-storybook": "^10.4.6",
    "globals": "^17.7.0",
    "husky": "^9.1.6",
    "lighthouse": "^13.4.0",
    "lint-staged": "^17.0.8",
    "openapi-typescript": "^7.6.1",
    "pa11y-ci": "^4.1.1",
    "prettier": "^3.3.3",
    "puppeteer": "^25.3.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "storybook": "^10.4.6",
    "typescript": "^5.7.0",
    "vite": "^8.1.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
